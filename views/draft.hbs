<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{pageTitle}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<main class="phone">
  <section class="draft-page">
    <h1 class="draft-page__title">Добавление степени</h1>

    {{#if degree}}
      <form class="draft-form">
        <fieldset class="draft-form__block">
          <legend class="draft-form__legend">Медиафайлы степени</legend>

          <!-- выбор файла кликом по плейсхолдеру 
               превью из MinIO не меняется-->
          <label class="field_picker">
            <span class="field__label">Изображение</span>
            <span class="picker__area" data-hint="Нажмите чтобы выбрать фото">
              <img class="draft-form__preview" src="{{degree.imageUrl}}" alt="{{degree.degreeName}}">
            </span>

            <input class="picker__input" type="file" name="image" accept="image/*">
          </label>

          <label class="field_picker">
            <span class="field__label">Видео</span>
            <span class="picker__area" data-hint="Нажмите, чтобы выбрать видео">
              <video class="draft-form__preview" src="{{degree.videoUrl}}"
                    poster="{{degree.imageUrl}}" autoplay muted loop playsinline></video>
            </span>

            <input class="picker__input" type="file" name="video" accept="video/*">
          </label>
        </fieldset>

        <fieldset class="draft-form__block">
          <legend class="draft-form__legend">Описание и параметры</legend>

          <label class="field">
            <span class="field__label">Название степени</span>
            <input class="field__input" type="text" name="degreeName" value="{{degree.degreeName}}">
          </label>

          <label class="field">
            <span class="field__label">Краткое описание</span>
            <input class="field__input" type="text" name="shortDescription"
                   value="{{degree.shortDescription}}">
          </label>

          <label class="field">
            <span class="field__label">Полное описание</span>
            <textarea class="field__input field__input--area" name="description"
                      rows="6">{{degree.description}}</textarea>
          </label>

          <label class="field">
            <span class="field__label">Верхняя граница индекса PaO₂/FiO₂, мм рт. ст.</span>
            <input class="field__input" type="number" name="pfRatioUpperBound"
                   value="{{degree.pfRatioUpperBound}}">
          </label>

          <label class="field">
            <span class="field__label">Госпитальная летальность, %</span>
            <input class="field__input" type="number" name="mortalityRate"
                   value="{{degree.mortalityRate}}">
          </label>
        </fieldset>
      </form>
    {{else}}
      <p class="grid-page__empty">Черновик степени отсутствует</p>
    {{/if}}
  </section>

  {{> tabBar}}
</main>
</body>
</html>
