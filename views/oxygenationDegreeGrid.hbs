<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{pageTitle}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<main class="phone">
  <section class="grid-page">
    <header class="grid-page__header">
      <h1 class="grid-page__title">Степени оксигенации</h1>

      <!-- Серверная фильтрация по индексу PaO2/FiO2, слайдер со шкалой и кнопка, метод GET -->
      <form class="filter" action="/oxygenation-degrees" method="get">
        <label class="filter__label" for="maxPfRatio">
          Индекс PaO₂/FiO₂ не выше <span class="filter__value">{{filter.value}}</span> мм рт. ст.
        </label>
        <div class="filter__row">
          <div class="filter__slider">
            <input class="filter_range" id="maxPfRatio" type="range" name="maxPfRatio"
                   min="{{filter.min}}" max="{{filter.max}}" step="{{filter.step}}" 
                   value="{{filter.value}}">
            <!-- Числовая шкала под слайдером -->
            <div class="filter__scale">
              {{#each filter.scale}}
                <span class="filter__mark">{{this}}</span>
              {{/each}}
            </div>
          </div>
          <button class="filter__submit" type="submit">Найти</button>
        </div>
      </form>
    </header>

    {{#if isEmpty}}
      <p class="grid-page__empty">Степеней с таким индексом не найдено</p>
    {{else}}
      <div class="grid">
        {{#each degrees}}
          <article class="degree-card">
            <!-- Клик по карточке открывает ленту с этой степени -->
            <a class="degree-card__link" href="/oxygenation-degrees/feed/{{this.id}}">
              <!-- Изображение степени из MinIO или изображение по умолчанию -->
              {{> oxygenationDegreeImage degree=this imageClass="degree-card__image"}}
              <div class="degree-card__body">
                <p class="degree-card__name">{{this.degreeName}}</p>
                <div class="degree-card__footer">
                  <!-- Поле предметной области, по которому работает фильтр -->
                  <span class="chip chip--light">PaO₂/FiO₂ ⩽ {{this.pfRatioUpperBound}}</span>
                  <!-- Количество добавлений в избранное - строки таблицы лайков -->
                  <div class="degree-card__likes" title="В избранном у врачей">
                    <svg class="degree-card__like-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21Z"
                            fill="currentColor"/>
                    </svg>
                    <span>{{this.likesCount}}</span>
                  </div>
                </div>
              </div>
            </a>

            <!-- Логическое удаление: POST-запрос, на сервере SQL UPDATE статуса.
                 Форма стоит рядом со ссылкой, потому что внутри <a> кнопки быть не может -->
            <form class="degree-card__delete" action="/oxygenation-degrees/{{this.id}}/delete" method="post">
              <button class="degree-card__delete-button" type="submit"
                      title="Удалить степень" aria-label="Удалить степень">
                <svg class="degree-card__delete-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/>
                </svg>
              </button>
            </form>
          </article>
        {{/each}}
      </div>
    {{/if}}
  </section>

  {{> oxygenationTabBar}}
</main>
</body>
</html>
