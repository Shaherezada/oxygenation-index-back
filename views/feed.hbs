<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>{{pageTitle}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<main class="phone">
  {{#if degree}}
    <section class="feed">
      <!-- видео степени из MinIO, вертикальная развертка на весь экран -->
      <video class="feed__video" src="{{degree.videoUrl}}" poster="{{degree.imageUrl}}"
             autoplay muted loop playsinline></video>

      <h1 class="feed__title">{{degree.degreeName}}</h1>

      <!-- избранное и переход к следующей степени - поверх видео справа
           звезда (вместо сердечка) повторяет элемент "в избранное" с MDCalc -->
      <aside class="feed__actions">
        <div class="feed__like" title="В избранном у врачей">
          <svg class="feed__like-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21Z"
                  fill="currentColor"/>
          </svg>
          <span class="feed__like-count">{{degree.likesCount}}</span>
        </div>
        <a class="feed__next" href="/oxygenation-degrees/feed/{{degree.id}}?next=true">
          Следующая
        </a>
      </aside>

      <div class="feed__bottom">
        <!-- два поля предметной области поверх видео -->
        <div class="feed__fields">
          <span class="chip">PaO&#8322;/FiO&#8322; до {{degree.pfRatioUpperBound}} мм рт. ст.</span>
          <span class="chip">Летальность {{degree.mortalityRate}} %</span>
        </div>

        <!-- описание с раскрытием больше/меньше -->
        <details class="feed__description">
          <summary class="feed__description-summary">
            <span class="feed__description-short">{{degree.shortDescription}}</span>
            <span class="feed__description-toggle"></span>
          </summary>
          <p class="feed__description-full">{{degree.description}}</p>
        </details>
      </div>
    </section>
  {{else}}
    <p class="grid-page__empty">Степень оксигенации не найдена</p>
  {{/if}}

  {{> tabBar}}
</main>
</body>
</html>
